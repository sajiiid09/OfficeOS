# ──────────────────────────────────────────────
# OfficeOS Frontend - Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── API ──────────────────────────────────────
PORT=8000                                 # Frontend dev server port
REACT_APP_BASE_URL=http://localhost:5500  # Backend API URL (must match backend's PORT)

# ─── Docker-only (optional) ──────────────────
# HOST=0.0.0.0                            # Bind to all interfaces inside Docker
# CHOKIDAR_USEPOLLING=true                # Fix file watching in Docker on Windows
# BROWSER=none                            # Prevent opening browser inside container
